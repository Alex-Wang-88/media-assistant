# Electron 连接本机 FastAPI 的地址
YOOM_API_URL=http://127.0.0.1:8000

# 仓库已有的沄荣 Provider 配置（Persona Agent 不使用）
YUNRONG_BASE_URL=
YUNRONG_SESSION_COOKIE=

# 流式 Agent API（普通聊天与 Persona 构建共同使用）
YUNBLOOM_SHARE_URL=
YUNBLOOM_API_KEY=

# 服务端基础设施
DATABASE_URL=postgresql+psycopg://yoom:yoom@127.0.0.1:5432/yoom
REDIS_URL=redis://127.0.0.1:6379/0
